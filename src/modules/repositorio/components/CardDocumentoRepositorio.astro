---
import type { DocumentoRepositorio } from "../services/repositorio.types";
import {
  FileTextIcon,
  ArrowRightIcon,
  GlobeIcon,
  BookBookmarkIcon,
  UsersGroupRoundedIcon,
} from "@solar-icons/react/outline";

interface Props {
  documento: DocumentoRepositorio;
}

const { documento } = Astro.props;
---

<article
  class="group/card relative flex flex-col justify-between rounded-[28px] bg-white/95 border border-white/80 shadow-[0_20px_45px_-18px_rgba(9,60,120,0.14),0_1px_3px_rgba(0,0,0,0.03)] backdrop-blur-md overflow-hidden transition-all duration-300"
>
  <!-- Ilustración / Mockup visual de documento con profundidad 3D y badge de año -->
  <div class="relative w-full p-4 pb-2 bg-gradient-to-b from-[#f4f8fc] to-[#eaf2fb] border-b border-black/[0.04] overflow-hidden group/sheet">
    <!-- Badge de Año flotante -->
    <span
      class="absolute top-4 right-4 z-20 font-mono text-xs font-bold text-[#0064c1] bg-white/90 backdrop-blur-md px-3 py-1 rounded-full border border-white/80 shadow-[0_2px_8px_-2px_rgba(0,100,193,0.2)]"
    >
      {documento.ano}
    </span>

    <!-- Hoja / Sheet de documento con efecto 3D y preview de líneas -->
    <div
      class="relative mx-auto mt-2 w-[92%] rounded-2xl bg-white p-4 shadow-[0_12px_24px_-10px_rgba(9,60,120,0.18),0_1px_2px_rgba(0,0,0,0.04)] border border-black/[0.04] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/sheet:scale-[1.02] overflow-hidden"
    >
      <div class="flex items-start gap-3">
        <!-- Icono con relieve celeste -->
        <span
          class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-white shadow-sm"
          style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1px 1px rgba(255,255,255,0.6), 0 4px 12px -2px rgba(58,138,244,0.4);"
        >
          <FileTextIcon size={20} strokeWidth={2} />
        </span>

        <!-- Líneas estilizadas representando el documento -->
        <div class="flex flex-col gap-1.5 flex-1 min-w-0 pt-1">
          <p class="m-0 text-[0.7rem] font-bold text-[#0a0a0a]/90 truncate leading-tight">
            {documento.titulo}
          </p>
          <div class="h-1.5 w-3/4 rounded-full bg-black/[0.06]"></div>
          <div class="h-1.5 w-1/2 rounded-full bg-black/[0.04]"></div>
        </div>
      </div>

      <div class="mt-3 flex flex-col gap-1">
        <div class="h-1 w-full rounded-full bg-black/[0.03]"></div>
        <div class="h-1 w-5/6 rounded-full bg-black/[0.03]"></div>
      </div>
    </div>
  </div>

  <!-- Cuerpo de la Card -->
  <div class="flex flex-col flex-1 p-5 md:p-6 justify-between gap-5">
    <div class="flex flex-col gap-3">
      <!-- Línea de investigación -->
      <span class="text-[0.68rem] font-bold uppercase tracking-[0.14em] text-[#0064c1]">
        {documento.lineaInvestigacion}
      </span>

      <!-- Título principal -->
      <h3 class="m-0 text-[0.98rem] md:text-[1.05rem] font-bold text-[#0a0a0a] tracking-tight leading-snug group-hover/card:text-[#0064c1] transition-colors duration-300 line-clamp-3">
        {documento.titulo}
      </h3>

      <!-- Metadatos: Tipo de fuente y País -->
      <div class="grid grid-cols-2 gap-3 pt-2 pb-1 border-t border-b border-black/[0.05]">
        <div class="flex flex-col gap-0.5">
          <span class="text-[0.68rem] font-medium text-[#787774]">Tipo de fuente bibliográfica</span>
          <span class="text-xs font-bold text-[#0a0a0a] truncate">{documento.tipoFuente}</span>
        </div>

        <div class="flex flex-col gap-0.5">
          <span class="text-[0.68rem] font-medium text-[#787774]">País</span>
          <span class="text-xs font-bold text-[#0a0a0a] truncate">{documento.pais}</span>
        </div>
      </div>

      <!-- Autores -->
      <div class="flex flex-col gap-1">
        <span class="text-[0.68rem] font-medium text-[#787774]">Autores</span>
        <p class="m-0 text-xs text-[#2f3437] leading-relaxed line-clamp-2">
          {documento.autores.join(", ")}
        </p>
      </div>
    </div>

    <!-- Botón Consultar Documento -->
    <div class="pt-3 border-t border-black/[0.06] mt-auto">
      <a
        href={`/dashboard/repositorio/${documento.id}`}
        class="group/btn relative inline-flex items-center justify-between w-full px-4 py-2.5 rounded-full text-xs font-semibold text-[#0064c1] bg-[#0064c1]/[0.05] border border-[#0064c1]/20 hover:bg-[#0064c1] hover:text-white transition-all duration-300 active:scale-[0.985] shadow-sm cursor-pointer"
      >
        <span>Consultar documento</span>
        <span
          class="grid h-6 w-6 place-items-center rounded-full bg-white/80 text-[#0064c1] group-hover/btn:bg-white group-hover/btn:text-[#0064c1] transition-all shadow-xs"
        >
          <ArrowRightIcon size={12} strokeWidth={2.2} />
        </span>
      </a>
    </div>
  </div>
</article>

---
import CustomSelect from "../../../components/CustomSelect.astro";
import Input from "../../../components/Input.astro";
import { mesesOpciones, semestresOpciones } from "../../red-aprendizaje/constants/opciones-fecha";
import {
  UserIcon,
  CardIcon,
  PhoneIcon,
  CalendarIcon,
  BookIcon,
  ArrowRightIcon,
  AltArrowLeftIcon,
  CheckCircleIcon,
  StarsMinimalisticIcon,
} from "@solar-icons/react/outline";
---

<div class="relative flex-1 flex flex-col w-full animate-rise isolate overflow-x-clip">
  <div class="flex-1 flex flex-col px-6 md:px-12 pt-8 md:pt-10 pb-16 max-w-4xl w-full mx-auto gap-8">
    <!-- Botón Volver a Usuarios -->
    <div>
      <a
        href="/dashboard/usuarios"
        class="group inline-flex items-center gap-1.5 text-xs font-semibold text-[#787774] hover:text-[#0064c1] transition-colors"
      >
        <AltArrowLeftIcon
          size={16}
          strokeWidth={2}
          className="transition-transform duration-200 group-hover:-translate-x-1"
        />
        <span>Volver a la lista de usuarios</span>
      </a>
    </div>

    <!-- Encabezado de la Página de Creación -->
    <header class="flex flex-col gap-2 pb-6 border-b border-black/[0.06]">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-[#0064c1]">
        <span class="h-2 w-2 rounded-full bg-[#0064c1]"></span>
        Formulario de Registro
      </div>

      <h1 class="m-0 text-[clamp(1.8rem,3vw,2.4rem)] font-bold text-[#0a0a0a] tracking-[-0.03em] leading-tight mix-blend-multiply opacity-95">
        Crear Nuevo Usuario
      </h1>

      <p class="m-0 text-sm text-[#787774] font-medium tracking-tight">
        Ingresa los datos del estudiante o investigador para vincularlo formalmente a la Red de Aprendizaje.
      </p>
    </header>

    <!-- Formulario Completo sin fondo de tarjeta ni sombras -->
    <div class="w-full">
      <form id="form-crear-usuario" class="flex flex-col gap-6" action="#" method="post">
        <!-- Sección 1: Información Personal -->
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-2 pb-2 border-b border-black/[0.05]">
            <span class="grid h-6 w-6 place-items-center rounded-lg bg-[#0064c1]/10 text-[#0064c1] text-xs font-bold">
              1
            </span>
            <span class="text-xs font-bold text-[#0a0a0a] uppercase tracking-wider">
              Información Personal
            </span>
          </div>

          <Input
            name="nombre"
            label="Nombre completo"
            placeholder="Ej. Alejandro Fernando Haro"
            autocomplete="name"
            icon={UserIcon}
            required
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Input
              name="cedula"
              label="Cédula de ciudadanía"
              inputmode="numeric"
              placeholder="0000000000"
              icon={CardIcon}
              required
            />
            <Input
              name="telefono"
              label="Número de teléfono"
              type="tel"
              placeholder="300 123 4567"
              autocomplete="tel"
              icon={PhoneIcon}
              required
            />
          </div>

          <!-- Fecha de nacimiento -->
          <div class="flex flex-col gap-2">
            <span class="flex items-center gap-2 text-[#0a0a0a] text-sm font-[560] tracking-[-0.01em]">
              <CalendarIcon size={18} strokeWidth={1.5} className="text-[#0064c1]" />
              Fecha de nacimiento
            </span>

            <div class="grid grid-cols-3 gap-3">
              <Input
                name="dia"
                type="number"
                placeholder="Día"
                min="1"
                max="31"
                required
              />

              <CustomSelect
                name="mes"
                label="Mes"
                placeholder="Mes"
                options={mesesOpciones}
                required
              />

              <Input
                name="anio"
                type="number"
                placeholder="Año"
                min="1900"
                max={new Date().getFullYear()}
                required
              />
            </div>
          </div>
        </div>

        <!-- Sección 2: Información Académica -->
        <div class="flex flex-col gap-4 pt-4">
          <div class="flex items-center gap-2 pb-2 border-b border-black/[0.05]">
            <span class="grid h-6 w-6 place-items-center rounded-lg bg-[#0064c1]/10 text-[#0064c1] text-xs font-bold">
              2
            </span>
            <span class="text-xs font-bold text-[#0a0a0a] uppercase tracking-wider">
              Información Académica
            </span>
          </div>

          <Input
            name="universidad"
            label="Universidad / Institución"
            placeholder="Ej. Universidad Nacional de Colombia"
            icon={BookIcon}
            required
          />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Input
              name="carrera"
              label="Programa académico / Carrera"
              placeholder="Ej. Ingeniería Ambiental"
              icon={BookIcon}
              required
            />

            <CustomSelect
              name="semestre"
              label="Semestre actual"
              placeholder="Seleccionar semestre"
              options={semestresOpciones}
              required
            />
          </div>
        </div>

        <!-- Botones de Acción -->
        <div class="flex items-center justify-end gap-3 pt-6 border-t border-black/[0.06] mt-4">
          <a
            href="/dashboard/usuarios"
            class="px-5 py-2.5 rounded-full text-xs font-semibold text-[#787774] hover:bg-black/[0.05] transition-colors cursor-pointer"
          >
            Cancelar
          </a>

          <button
            type="submit"
            class="group/btn relative inline-flex items-center justify-center gap-2 px-7 py-2.5 rounded-full text-white text-xs font-semibold tracking-[-0.01em] cursor-pointer overflow-hidden transition-all duration-300 active:scale-[0.985] shadow-sm"
            style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
          >
            <span class="relative z-10">Guardar y registrar usuario</span>
            <ArrowRightIcon
              size={14}
              strokeWidth={2}
              className="relative z-10 transition-transform duration-300 group-hover/btn:translate-x-0.5"
            />
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

---
import type { ItemNewsFeed } from "../services/dashboard.types";
import {
  NotesIcon,
  AltArrowLeftIcon,
  AltArrowRightIcon,
  ArrowRightIcon,
  StarsMinimalisticIcon,
  LinkIcon,
  ClockCircleIcon,
} from "@solar-icons/react/outline";

interface Props {
  noticias: ItemNewsFeed[];
}

const { noticias } = Astro.props;
---

<div
  class="relative flex flex-col justify-between rounded-[32px] p-6 md:p-8 bg-white/95 border border-white/80 shadow-[0_24px_50px_-18px_rgba(9,60,120,0.18),0_1px_3px_rgba(0,0,0,0.03)] backdrop-blur-md transition-all duration-300 group/card min-h-[440px]"
  data-carousel="news"
>
  <!-- Efecto de volumen 3D superior y glow celeste -->
  <div
    class="absolute inset-x-8 top-0 h-[2.5px] bg-gradient-to-r from-transparent via-[#0064c1]/50 to-transparent pointer-events-none"
  >
  </div>

  <!-- Header de la Card del Carrusel -->
  <div
    class="flex items-center justify-between gap-4 pb-4 border-b border-black/[0.06]"
  >
    <div class="flex items-center gap-3">
      <span
        class="grid h-11 w-11 place-items-center rounded-2xl text-white shadow-sm"
        style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 12px -2px rgba(58,138,244,0.4);"
      >
        <NotesIcon size={22} strokeWidth={1.8} />
      </span>
      <div class="flex flex-col">
        <span
          class="text-[0.68rem] font-bold uppercase tracking-[0.16em] text-[#0064c1]"
        >
          Novedades
        </span>
        <h3 class="m-0 text-lg font-bold text-[#0a0a0a] tracking-tight">
          News Feed
        </h3>
      </div>
    </div>

    <!-- Indicador y Controles interactivos del Carrusel -->
    <div class="flex items-center gap-2.5">
      <span
        class="font-mono text-xs font-semibold text-[#787774] bg-black/[0.04] px-2.5 py-1 rounded-full"
        data-counter
      >
        01 / {String(noticias.length).padStart(2, "0")}
      </span>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          data-prev
          class="grid h-8 w-8 place-items-center rounded-full bg-white border border-black/10 text-[#787774] transition-all duration-200 hover:bg-[#0064c1] hover:text-white hover:border-[#0064c1] active:scale-90 shadow-sm cursor-pointer"
          aria-label="Noticia anterior"
        >
          <AltArrowLeftIcon size={16} strokeWidth={2} />
        </button>
        <button
          type="button"
          data-next
          class="grid h-8 w-8 place-items-center rounded-full bg-white border border-black/10 text-[#787774] transition-all duration-200 hover:bg-[#0064c1] hover:text-white hover:border-[#0064c1] active:scale-90 shadow-sm cursor-pointer"
          aria-label="Siguiente noticia"
        >
          <AltArrowRightIcon size={16} strokeWidth={2} />
        </button>
      </div>
    </div>
  </div>

  <!-- Slides Track (Carrusel con visualización de metadatos e imagen 3D) -->
  <div class="relative min-h-[240px] my-5 overflow-hidden">
    {
      noticias.map((item, index) => (
        <div
          class:list={[
            "carousel-slide flex flex-col gap-3.5 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]",
            index === 0
              ? "opacity-100 translate-x-0 relative pointer-events-auto"
              : "opacity-0 translate-x-10 absolute inset-0 pointer-events-none",
          ]}
          data-slide-index={index}
          data-url={item.enlace}
        >
          <!-- Metadata Tag superior -->
          <div class="flex items-center justify-between gap-2 text-xs font-semibold text-[#787774]">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 text-[#0064c1] font-bold uppercase tracking-wider text-[0.68rem] bg-[#0064c1]/[0.08] px-2.5 py-0.5 rounded-full">
                <StarsMinimalisticIcon size={13} strokeWidth={2} />
                {item.categoria}
              </span>
              <span>•</span>
              <span class="truncate">{item.fecha}</span>
            </div>

            {item.fuente && (
              <span class="inline-flex items-center gap-1 text-[0.7rem] text-[#787774] font-medium">
                <LinkIcon size={13} strokeWidth={1.5} />
                {item.fuente}
              </span>
            )}
          </div>

          <!-- Card Principal con Imagen Destacada -->
          <div class="flex flex-col rounded-2xl bg-black/[0.02] border border-black/[0.05] overflow-hidden transition-all hover:bg-black/[0.04] group/preview">
            {item.imagen && (
              <div class="relative w-full h-44 sm:h-48 overflow-hidden bg-black/5">
                <img
                  src={item.imagen}
                  alt={item.titulo}
                  class="w-full h-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/preview:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent pointer-events-none"></div>
                
                {item.fuente && (
                  <span class="absolute bottom-2.5 left-3 inline-flex items-center gap-1.5 text-[0.72rem] text-white/95 font-semibold bg-black/40 backdrop-blur-md px-2.5 py-1 rounded-full border border-white/20">
                    <LinkIcon size={12} strokeWidth={2} />
                    {item.fuente}
                  </span>
                )}
              </div>
            )}

            <div class="flex flex-col gap-2 p-4">
              <h4 class="m-0 text-base md:text-[1.12rem] font-bold text-[#0a0a0a] tracking-tight leading-snug group-hover/card:text-[#0064c1] transition-colors duration-300 line-clamp-2">
                {item.titulo}
              </h4>

              <p class="m-0 text-xs md:text-sm text-[#2f3437] leading-relaxed line-clamp-2">
                {item.descripcion}
              </p>

              {item.lecturaMinutos && (
                <span class="flex items-center gap-1 text-[0.72rem] font-medium text-[#787774] mt-0.5">
                  <ClockCircleIcon size={13} strokeWidth={1.5} />
                  Lectura estimada: {item.lecturaMinutos} min
                </span>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Footer con Botón y Acción consistente -->
  <div
    class="flex items-center justify-between pt-4 border-t border-black/[0.06] mt-auto"
  >
    <a
      id="news-primary-link"
      href={noticias[0]?.enlace || "/dashboard/news"}
      target={noticias[0]?.enlace.startsWith("http") ? "_blank" : "_self"}
      rel="noopener noreferrer"
      class="group/btn relative inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full text-white text-xs font-semibold tracking-[-0.01em] whitespace-nowrap cursor-pointer overflow-hidden transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] active:scale-[0.985] shadow-sm"
      style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 14px -3px rgba(58,138,244,0.4); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
    >
      <span class="relative z-10">Leer noticia</span>
      <ArrowRightIcon
        size={14}
        strokeWidth={2}
        className="relative z-10 transition-transform duration-300 group-hover/btn:translate-x-0.5"
      />
    </a>

    <a
      href="/dashboard/news"
      class="group/link text-xs font-semibold text-[#0064c1] hover:text-[#0f2fe8] transition-colors inline-flex items-center gap-1"
    >
      <span>Ver todas</span>
      <ArrowRightIcon
        size={13}
        strokeWidth={2}
        className="transition-transform duration-300 group-hover/link:translate-x-0.5"
      />
    </a>
  </div>
</div>

<script>
  function setupNewsCarousel() {
    const container = document.querySelector('[data-carousel="news"]');
    if (!container || container.getAttribute("data-initialized")) return;
    container.setAttribute("data-initialized", "true");

    const slides = container.querySelectorAll<HTMLElement>(".carousel-slide");
    const counter = container.querySelector("[data-counter]");
    const prevBtn = container.querySelector("[data-prev]");
    const nextBtn = container.querySelector("[data-next]");
    const primaryLink = container.querySelector<HTMLAnchorElement>("#news-primary-link");

    if (!slides.length) return;

    let currentIndex = 0;
    const total = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove(
            "opacity-0",
            "translate-x-10",
            "pointer-events-none",
            "absolute",
            "-translate-x-10",
          );
          slide.classList.add(
            "opacity-100",
            "translate-x-0",
            "relative",
            "pointer-events-auto",
          );

          // Actualizar el enlace principal del botón
          const url = slide.getAttribute("data-url");
          if (primaryLink && url) {
            primaryLink.href = url;
            primaryLink.target = url.startsWith("http") ? "_blank" : "_self";
          }
        } else {
          slide.classList.remove(
            "opacity-100",
            "translate-x-0",
            "relative",
            "pointer-events-auto",
          );
          slide.classList.add(
            "opacity-0",
            i < index ? "-translate-x-10" : "translate-x-10",
            "pointer-events-none",
            "absolute",
          );
        }
      });

      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
      }
    }

    function next() {
      currentIndex = (currentIndex + 1) % total;
      showSlide(currentIndex);
    }

    function prev() {
      currentIndex = (currentIndex - 1 + total) % total;
      showSlide(currentIndex);
    }

    nextBtn?.addEventListener("click", next);
    prevBtn?.addEventListener("click", prev);

    // Auto rotación suave cada 6.5 segundos
    const timer = setInterval(next, 6500);
    container.addEventListener("mouseenter", () => clearInterval(timer), {
      once: true,
    });
  }

  setupNewsCarousel();
  document.addEventListener("astro:page-load", setupNewsCarousel);
</script>

---
import {
  HomeIcon,
  LibraryIcon,
  UsersGroupRoundedIcon,
  NotesIcon,
  VideocameraIcon,
  UsersGroupTwoRoundedIcon,
  FolderWithFilesIcon,
  ChatSquareIcon,
  HeadphonesRoundIcon,
  SettingsIcon,
  AltArrowLeftIcon,
  AltArrowDownIcon,
  LetterIcon,
  UserPlusIcon,
} from "@solar-icons/react/outline";

interface SubItem {
  href: string;
  label: string;
  badge?: string;
  badgeType?: "count" | "new";
  icon?: any;
}

interface Item {
  href?: string;
  label: string;
  icon: any;
  badge?: string;
  badgeType?: "count" | "new";
  subItems?: SubItem[];
}

interface Props {
  active?: string;
}

const { active = "Inicio" } = Astro.props;

const explorar: Item[] = [
  { href: "/dashboard", label: "Inicio", icon: HomeIcon },
  { href: "/dashboard/repositorio", label: "Repositorio", icon: LibraryIcon, badge: "48" },
  { href: "/dashboard/news", label: "News Feed", icon: NotesIcon, badge: "3" },
  { href: "/dashboard/youtube", label: "Youtube Feed", icon: VideocameraIcon, badge: "1" },
];

const administracion: Item[] = [
  { href: "/dashboard/usuarios", label: "Usuarios", icon: UsersGroupTwoRoundedIcon },
  {
    label: "Red de aprendizaje",
    icon: UsersGroupRoundedIcon,
    subItems: [
      {
        href: "/dashboard/red-aprendizaje",
        label: "Usuarios Nuevos",
        icon: UserPlusIcon,
        badge: "8",
        badgeType: "count",
      },
      {
        href: "/dashboard/red-aprendizaje/correo",
        label: "Correo",
        icon: LetterIcon,
      },
    ],
  },
  { href: "#", label: "Contenido Repositorios", icon: FolderWithFilesIcon },
  {
    href: "/dashboard/contenido-feed",
    label: "Contenido Feed",
    icon: ChatSquareIcon,
    badge: "4",
    badgeType: "count",
  },
  { href: "#", label: "Soporte", icon: HeadphonesRoundIcon },
  { href: "#", label: "Ajustes", icon: SettingsIcon },
];
---

<aside
  id="main-sidebar"
  data-collapsed="false"
  class="group/sidebar sticky top-0 flex h-svh w-[17.5rem] data-[collapsed=true]:w-[4.85rem] shrink-0 flex-col justify-between border-r border-black/[0.07] bg-[#fbfbfa]/95 backdrop-blur-md px-3 py-5 select-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] z-40"
>
  <!-- Botón toggle tipo flecha en el borde derecho -->
  <button
    type="button"
    id="toggle-sidebar-btn"
    class="absolute -right-3.5 top-7 z-50 grid h-7 w-7 place-items-center rounded-full bg-white border border-black/10 text-[#787774] shadow-[0_4px_12px_-2px_rgba(0,0,0,0.12)] transition-all duration-200 hover:text-[#0064c1] hover:scale-110 hover:border-[#0064c1]/40 active:scale-95 cursor-pointer"
    aria-label="Contraer o expandir barra lateral"
    title="Contraer / Expandir"
  >
    <AltArrowLeftIcon
      size={16}
      strokeWidth={2.2}
      className="transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[collapsed=true]/sidebar:rotate-180 text-[#2f3437] group-hover:text-[#0064c1]"
    />
  </button>

  <div class="flex flex-col gap-6 overflow-hidden">
    <!-- Encabezado con Logo ampliado y centrado -->
    <div class="flex items-center justify-center px-1 pt-1 h-12">
      <a
        href="/"
        class="group/logo flex items-center justify-center no-underline overflow-hidden shrink-0"
        aria-label="Volver al inicio"
      >
        <img
          src="/Group 19.svg"
          alt="Logo Observatorio"
          class="h-11 w-auto max-w-[12rem] object-contain transition-transform duration-300 group-hover/logo:scale-105 shrink-0"
        />
      </a>
    </div>

    <!-- Navegación principal -->
    <nav class="flex flex-1 flex-col gap-5 overflow-y-auto overscroll-contain pr-0.5 custom-scrollbar">
      <!-- Sección Explorar -->
      <div class="flex flex-col gap-1">
        <p
          class="m-0 mb-1 px-3 text-[0.66rem] font-bold uppercase tracking-[0.16em] text-[#787774] whitespace-nowrap transition-opacity duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:h-0 group-data-[collapsed=true]/sidebar:mb-0 group-data-[collapsed=true]/sidebar:overflow-hidden"
        >
          Explorar
        </p>
        {
          explorar.map(({ icon: Icon, ...item }) => {
            const esActivo = active === item.label;
            return (
              <a
                href={item.href}
                title={item.label}
                class:list={[
                  "group relative flex items-center h-11 px-1.5 rounded-2xl text-sm font-medium tracking-[-0.01em] no-underline transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden",
                  esActivo
                    ? "bg-white text-[#0064c1] font-semibold border border-white/80 shadow-[0_4px_16px_-4px_rgba(9,60,120,0.12),0_1px_2px_rgba(0,0,0,0.04)]"
                    : "text-[#2f3437] hover:bg-black/[0.04] hover:text-[#0a0a0a] active:scale-[0.985]",
                ]}
              >
                <!-- Contenedor fijo de ícono con posición fija absoluta izquierda -->
                <div class="grid h-10 w-10 shrink-0 place-items-center">
                  <Icon
                    size={20}
                    strokeWidth={esActivo ? 2 : 1.5}
                    class:list={[
                      "shrink-0 transition-colors duration-200",
                      esActivo ? "text-[#0064c1]" : "text-[#787774] group-hover:text-[#0a0a0a]",
                    ]}
                  />
                </div>

                <span class="truncate whitespace-nowrap ml-1.5 transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:invisible">
                  {item.label}
                </span>

                {item.badge && item.badgeType === "new" && (
                  <span
                    class="ml-auto mr-1.5 px-2 py-0.5 rounded-full text-white text-[0.66rem] font-semibold leading-tight shadow-sm shrink-0 whitespace-nowrap transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:p-0 group-data-[collapsed=true]/sidebar:overflow-hidden"
                    style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1px 1px rgba(255,255,255,0.6), 0 2px 8px -1px rgba(58,138,244,0.45); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
                  >
                    {item.badge}
                  </span>
                )}

                {item.badge && item.badgeType !== "new" && (
                  <span
                    class:list={[
                      "ml-auto mr-1.5 px-2 py-0.5 rounded-full text-[0.7rem] font-semibold leading-tight font-mono shrink-0 whitespace-nowrap transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:p-0 group-data-[collapsed=true]/sidebar:overflow-hidden",
                      esActivo
                        ? "bg-[#0064c1]/10 text-[#0064c1]"
                        : "bg-black/[0.05] text-[#787774] group-hover:bg-black/[0.08] group-hover:text-[#0a0a0a]",
                    ]}
                  >
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })
        }
      </div>

      <!-- Sección Administración -->
      <div class="flex flex-col gap-1">
        <p
          class="m-0 mb-1 px-3 text-[0.66rem] font-bold uppercase tracking-[0.16em] text-[#787774] whitespace-nowrap transition-opacity duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:h-0 group-data-[collapsed=true]/sidebar:mb-0 group-data-[collapsed=true]/sidebar:overflow-hidden"
        >
          Administración
        </p>
        {
          administracion.map(({ icon: Icon, subItems, ...item }) => {
            if (subItems && subItems.length > 0) {
              const tieneHijoActivo = subItems.some((s) => s.label === active);
              const esPadreActivo = active === item.label || tieneHijoActivo;

              return (
                <div
                  class="group/collapsible flex flex-col transition-all duration-200"
                  data-collapsible
                  data-open={esPadreActivo ? "true" : "false"}
                >
                  <button
                    type="button"
                    class:list={[
                      "w-full group relative flex items-center h-11 px-1.5 rounded-2xl text-sm font-medium tracking-[-0.01em] transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden cursor-pointer select-none border-none text-left bg-transparent",
                      esPadreActivo
                        ? "bg-white/80 text-[#0064c1] font-semibold border border-white/80 shadow-[0_2px_10px_-3px_rgba(9,60,120,0.08)]"
                        : "text-[#2f3437] hover:bg-black/[0.04] hover:text-[#0a0a0a]",
                    ]}
                    data-collapsible-trigger
                  >
                    <div class="grid h-10 w-10 shrink-0 place-items-center">
                      <Icon
                        size={20}
                        strokeWidth={esPadreActivo ? 2 : 1.5}
                        class:list={[
                          "shrink-0 transition-colors duration-200",
                          esPadreActivo ? "text-[#0064c1]" : "text-[#787774] group-hover:text-[#0a0a0a]",
                        ]}
                      />
                    </div>

                    <span class="truncate whitespace-nowrap ml-1.5 transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:invisible">
                      {item.label}
                    </span>

                    <AltArrowDownIcon
                      size={14}
                      strokeWidth={2.2}
                      className="ml-auto mr-1.5 text-[#787774] transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[open=true]/collapsible:rotate-180 group-data-[collapsed=true]/sidebar:hidden shrink-0"
                    />
                  </button>

                  <!-- Sub-opciones desplegables con animación suave de apertura y cierre -->
                  <div
                    class="collapsible-content overflow-hidden transition-[height,opacity] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-data-[collapsed=true]/sidebar:hidden"
                    style={esPadreActivo ? "" : "height: 0px; opacity: 0;"}
                  >
                    <div class="flex flex-col gap-1 pl-2.5 pr-1 pt-1.5 pb-1 ml-4 my-0.5 border-l-2 border-slate-200/80">
                      {subItems.map((sub) => {
                        const esSubActivo = active === sub.label;
                        const SubIcon = sub.icon;
                        return (
                          <a
                            href={sub.href}
                            class:list={[
                              "group/sub flex items-center h-10 px-2 rounded-xl text-xs font-medium no-underline transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]",
                              esSubActivo
                                ? "bg-white text-[#0064c1] font-bold shadow-[0_2px_8px_-2px_rgba(9,60,120,0.12)] border border-white/90"
                                : "text-[#4b5563] hover:bg-black/[0.04] hover:text-[#0a0a0a]",
                            ]}
                          >
                            {SubIcon && (
                              <div class="grid h-6 w-6 shrink-0 place-items-center mr-2">
                                <SubIcon
                                  size={16}
                                  strokeWidth={esSubActivo ? 2 : 1.5}
                                  class:list={[
                                    "shrink-0 transition-colors duration-200",
                                    esSubActivo ? "text-[#0064c1]" : "text-[#787774] group-hover/sub:text-[#0a0a0a]",
                                  ]}
                                />
                              </div>
                            )}
                            <span class="truncate">{sub.label}</span>

                            {sub.badge && (
                              <span
                                class:list={[
                                  "ml-auto px-2 py-0.5 rounded-full text-[0.68rem] font-bold font-mono shrink-0 transition-colors",
                                  esSubActivo
                                    ? "bg-[#0064c1]/10 text-[#0064c1]"
                                    : "bg-black/[0.05] text-[#787774]",
                                ]}
                              >
                                {sub.badge}
                              </span>
                            )}
                          </a>
                        );
                      })}
                    </div>
                  </div>
                </div>
              );
            }

            const esActivo = active === item.label;
            return (
              <a
                href={item.href}
                title={item.label}
                class:list={[
                  "group relative flex items-center h-11 px-1.5 rounded-2xl text-sm font-medium tracking-[-0.01em] no-underline transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] overflow-hidden",
                  esActivo
                    ? "bg-white text-[#0064c1] font-semibold border border-white/80 shadow-[0_4px_16px_-4px_rgba(9,60,120,0.12),0_1px_2px_rgba(0,0,0,0.04)]"
                    : "text-[#2f3437] hover:bg-black/[0.04] hover:text-[#0a0a0a] active:scale-[0.985]",
                ]}
              >
                <!-- Contenedor fijo de ícono con posición fija absoluta izquierda -->
                <div class="grid h-10 w-10 shrink-0 place-items-center">
                  <Icon
                    size={20}
                    strokeWidth={esActivo ? 2 : 1.5}
                    class:list={[
                      "shrink-0 transition-colors duration-200",
                      esActivo ? "text-[#0064c1]" : "text-[#787774] group-hover:text-[#0a0a0a]",
                    ]}
                  />
                </div>

                <span class="truncate whitespace-nowrap ml-1.5 transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:invisible">
                  {item.label}
                </span>

                {item.badge && item.badgeType === "new" && (
                  <span
                    class="ml-auto mr-1.5 px-2 py-0.5 rounded-full text-white text-[0.66rem] font-semibold leading-tight shadow-sm shrink-0 whitespace-nowrap transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:p-0 group-data-[collapsed=true]/sidebar:overflow-hidden"
                    style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1px 1px rgba(255,255,255,0.6), 0 2px 8px -1px rgba(58,138,244,0.45); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
                  >
                    {item.badge}
                  </span>
                )}

                {item.badge && item.badgeType !== "new" && (
                  <span
                    class:list={[
                      "ml-auto mr-1.5 px-2 py-0.5 rounded-full text-[0.7rem] font-semibold leading-tight font-mono shrink-0 whitespace-nowrap transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:p-0 group-data-[collapsed=true]/sidebar:overflow-hidden",
                      esActivo
                        ? "bg-[#0064c1]/10 text-[#0064c1]"
                        : "bg-black/[0.05] text-[#787774] group-hover:bg-black/[0.08] group-hover:text-[#0a0a0a]",
                    ]}
                  >
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })
        }
      </div>
    </nav>
  </div>

  <!-- Tarjeta de Usuario Institucional con posición fija del avatar -->
  <div
    class="flex items-center gap-2.5 rounded-[20px] border border-white/80 bg-white/90 p-1.5 shadow-[0_10px_25px_-8px_rgba(9,60,120,0.15)] transition-all duration-300 hover:shadow-[0_14px_30px_-6px_rgba(9,60,120,0.22)] overflow-hidden shrink-0"
  >
    <div class="grid h-10 w-10 shrink-0 place-items-center">
      <span
        class="grid h-9 w-9 place-items-center rounded-2xl text-white text-xs font-bold shadow-sm"
        style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 4px 14px -3px rgba(58,138,244,0.4); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
        aria-hidden="true"
      >
        UI
      </span>
    </div>
    <div class="flex min-w-0 flex-col pl-0.5 transition-all duration-200 group-data-[collapsed=true]/sidebar:opacity-0 group-data-[collapsed=true]/sidebar:w-0 group-data-[collapsed=true]/sidebar:invisible">
      <span class="truncate text-xs font-semibold text-[#0a0a0a]"
        >Usuario institucional</span
      >
      <span class="truncate text-[0.72rem] text-[#787774]"
        >usuario@observatorio.edu</span
      >
    </div>
  </div>
</aside>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById("main-sidebar");
    const toggleBtn = document.getElementById("toggle-sidebar-btn");

    if (sidebar && toggleBtn && !sidebar.getAttribute("data-initialized")) {
      sidebar.setAttribute("data-initialized", "true");

      const savedState = localStorage.getItem("sidebar-collapsed");
      if (savedState === "true") {
        sidebar.setAttribute("data-collapsed", "true");
      }

      toggleBtn.addEventListener("click", () => {
        const isCollapsed = sidebar.getAttribute("data-collapsed") === "true";
        const nextState = isCollapsed ? "false" : "true";
        sidebar.setAttribute("data-collapsed", nextState);
        localStorage.setItem("sidebar-collapsed", nextState);
      });
    }

    // Manejo de acordeón animado para elementos desplegables
    const collapsibles = document.querySelectorAll("[data-collapsible]");
    collapsibles.forEach((collapsible) => {
      const trigger = collapsible.querySelector("[data-collapsible-trigger]");
      const content = collapsible.querySelector(".collapsible-content") as HTMLElement | null;

      if (!trigger || !content || trigger.getAttribute("data-accordion-init")) return;
      trigger.setAttribute("data-accordion-init", "true");

      // Inicializar altura si viene abierto
      if (collapsible.getAttribute("data-open") === "true") {
        content.style.height = "auto";
        content.style.opacity = "1";
      } else {
        content.style.height = "0px";
        content.style.opacity = "0";
      }

      trigger.addEventListener("click", () => {
        const isOpen = collapsible.getAttribute("data-open") === "true";

        if (isOpen) {
          // Animar cierre: calcular altura actual primero y luego llevar a 0
          content.style.height = `${content.scrollHeight}px`;
          content.style.opacity = "1";

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              content.style.height = "0px";
              content.style.opacity = "0";
              collapsible.setAttribute("data-open", "false");
            });
          });
        } else {
          // Animar apertura: expandir a scrollHeight y luego dejar en auto
          collapsible.setAttribute("data-open", "true");
          content.style.height = `${content.scrollHeight}px`;
          content.style.opacity = "1";

          const handleTransitionEnd = (e: TransitionEvent) => {
            if (e.propertyName === "height" && collapsible.getAttribute("data-open") === "true") {
              content.style.height = "auto";
              content.removeEventListener("transitionend", handleTransitionEnd);
            }
          };
          content.addEventListener("transitionend", handleTransitionEnd);
        }
      });
    });
  }

  setupSidebar();
  document.addEventListener("astro:page-load", setupSidebar);
</script>

---
import SkyShader from "./SkyShader.astro";
import {
  Home2Icon,
  Book2Icon,
  UsersGroupRoundedIcon,
  DocumentTextIcon,
  ClapperboardPlayIcon,
  UserIcon,
  FolderWithFilesIcon,
  LayersMinimalisticIcon,
  HelpIcon,
  SettingsIcon,
} from "@solar-icons/react/outline";

interface ElementoNav {
  etiqueta: string;
  href: string;
  badge?: number;
  chip?: string;
  icono: any;
}

interface SeccionNav {
  titulo: string;
  items: ElementoNav[];
}

interface Props {
  active?: string;
}

const { active = "Inicio" } = Astro.props;

const secciones: SeccionNav[] = [
  {
    titulo: "Explorar",
    items: [
      { etiqueta: "Inicio", href: "#", icono: Home2Icon },
      { etiqueta: "Repositorio", href: "#", badge: 48, icono: Book2Icon },
      { etiqueta: "Red de aprendizaje", href: "#", chip: "Nuevo", icono: UsersGroupRoundedIcon },
      { etiqueta: "News Feed", href: "#", badge: 12, icono: DocumentTextIcon },
      { etiqueta: "Youtube Feed", href: "#", badge: 6, icono: ClapperboardPlayIcon },
    ],
  },
  {
    titulo: "Administración",
    items: [
      { etiqueta: "Usuarios", href: "#", icono: UserIcon },
      { etiqueta: "Contenido Repositorios", href: "#", icono: FolderWithFilesIcon },
      { etiqueta: "Contenido Feed", href: "#", icono: LayersMinimalisticIcon },
    ],
  },
];

const itemsInferiores: ElementoNav[] = [
  { etiqueta: "Soporte", href: "#", icono: HelpIcon },
  { etiqueta: "Ajustes", href: "#", icono: SettingsIcon },
];
---

<aside
  id="sidebar"
  class="sticky top-0 z-40 w-72 h-svh shrink-0 flex flex-col bg-[#fbfbfa] border-r border-[#0000000f] select-none"
  aria-label="Navegación principal"
>
  <!-- Encabezado con Logo oficial y Branding como en index.astro -->
  <div class="px-5 pt-5 pb-3 flex flex-col gap-3">
    <div class="flex items-center gap-3">
      <img
        src="/Group 19.svg"
        alt="Logo Observatorio de Responsabilidad Social y Sostenibilidad"
        class="h-10 w-auto object-contain transition-transform duration-300 hover:scale-[1.03]"
      />
      <div class="flex flex-col min-w-0">
        <span class="text-[0.66rem] font-semibold tracking-[0.14em] uppercase text-[#0064c1]">
          Observatorio
        </span>
        <span class="text-[0.88rem] font-bold text-[#0a0a0a] tracking-[-0.02em] truncate leading-tight">
          RS &amp; Sostenibilidad
        </span>
      </div>
    </div>
  </div>

  <!-- Tarjeta de arte encapsulada (Idéntica a la tarjeta izquierda de index.astro) -->
  <div class="px-3 pb-2">
    <div
      class="relative overflow-hidden h-24 bg-[#cfe6fb] rounded-[18px] shadow-[inset_0_1px_2px_rgba(255,255,255,0.7)] transition-transform duration-300 hover:scale-[1.01]"
    >
      <SkyShader intensity="soft" />

      <!-- Grid decorativo de líneas blueprint -->
      <div
        class="absolute inset-0 grid grid-cols-4 grid-rows-2 opacity-15 pointer-events-none"
      >
        {Array.from({ length: 8 }).map(() => (
          <span class="border border-white/60" />
        ))}
      </div>

      <!-- Watermark decorativo -->
      <p
        class="absolute left-1 bottom-[-0.6rem] m-0 select-none pointer-events-none whitespace-nowrap text-[#1f5db4] opacity-[0.08] text-[2.6rem] font-bold leading-[0.8] tracking-[-0.06em]"
        aria-hidden="true"
      >
        Observatorio
      </p>

      <!-- Contenido de la tarjeta -->
      <div class="absolute z-10 left-3.5 right-3.5 bottom-2.5 flex flex-col">
        <p class="m-0 text-[#0064c1] text-[0.62rem] font-bold tracking-[0.14em] uppercase">
          Plataforma
        </p>
        <p class="m-0 text-[#0a0a0a] text-xs font-semibold tracking-[-0.02em] leading-tight mix-blend-multiply opacity-90">
          Red de Aprendizaje
        </p>
      </div>
    </div>
  </div>

  <!-- Navegación de secciones -->
  <nav class="flex-1 overflow-y-auto px-3 py-2 flex flex-col gap-4">
    {
      secciones.map((seccion) => (
        <div class="flex flex-col gap-1">
          <p class="px-3 mb-1 text-[0.68rem] font-semibold tracking-[0.14em] uppercase text-[#787774]">
            {seccion.titulo}
          </p>
          <ul class="list-none m-0 p-0 flex flex-col gap-0.5">
            {seccion.items.map((item) => {
              const esActivo = item.etiqueta === active;
              const Icono = item.icono;

              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={esActivo ? "page" : undefined}
                    class:list={[
                      "group relative flex items-center justify-between px-3 py-2 rounded-xl text-[0.92rem] tracking-[-0.01em] no-underline transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)]",
                      esActivo
                        ? "bg-[#0064c1]/10 text-[#0064c1] font-semibold shadow-[inset_0_0_0_1px_rgba(0,100,193,0.14)]"
                        : "text-[#2f3437] font-medium hover:bg-[#f1f0ec] hover:text-[#0a0a0a] hover:translate-x-0.5 active:scale-[0.985]"
                    ]}
                  >
                    <!-- Indicador lateral activo -->
                    {esActivo && (
                      <span class="absolute left-0 top-2 bottom-2 w-1 bg-[#0064c1] rounded-r-full shadow-[0_0_8px_rgba(0,100,193,0.5)]" />
                    )}

                    <div class="flex items-center gap-2.5 min-w-0">
                      <Icono
                        size={18}
                        strokeWidth={esActivo ? 2 : 1.6}
                        className={esActivo ? "text-[#0064c1] shrink-0" : "text-[#787774] group-hover:text-[#0a0a0a] transition-colors shrink-0"}
                      />
                      <span class="truncate">{item.etiqueta}</span>
                    </div>

                    <div class="flex items-center gap-1.5 shrink-0 ml-2">
                      {item.chip && (
                        <span
                          class="px-2 py-0.5 rounded-full text-white text-[0.66rem] font-semibold leading-tight shadow-sm"
                          style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1px 1px rgba(255,255,255,0.6), 0 2px 8px -1px rgba(58,138,244,0.45); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
                        >
                          {item.chip}
                        </span>
                      )}

                      {item.badge != null && (
                        <span
                          class:list={[
                            "min-w-5 px-1.5 py-0.5 rounded-md text-center text-[0.7rem] font-medium font-mono leading-none",
                            esActivo
                              ? "bg-[#0064c1]/15 text-[#0064c1]"
                              : "bg-[#0000000a] text-[#787774] group-hover:bg-[#00000012] group-hover:text-[#0a0a0a]"
                          ]}
                        >
                          {item.badge}
                        </span>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </nav>

  <!-- Items inferiores (Soporte / Ajustes) -->
  <div class="px-3 pt-2 pb-1 border-t border-[#0000000a]">
    <ul class="list-none m-0 p-0 flex flex-col gap-0.5">
      {
        itemsInferiores.map((item) => {
          const Icono = item.icono;
          return (
            <li>
              <a
                href={item.href}
                class="group flex items-center gap-2.5 px-3 py-2 rounded-xl text-[0.92rem] font-medium tracking-[-0.01em] no-underline text-[#787774] transition-all duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-[#f1f0ec] hover:text-[#0a0a0a] hover:translate-x-0.5 active:scale-[0.985]"
              >
                <Icono
                  size={18}
                  strokeWidth={1.6}
                  className="text-[#787774] group-hover:text-[#0a0a0a] transition-colors shrink-0"
                />
                <span class="truncate">{item.etiqueta}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Tarjeta de Usuario con estética idéntica al botón e index.astro -->
  <div class="p-3 pt-1">
    <a
      href="#"
      class="group flex items-center gap-3 p-2.5 rounded-2xl border border-[#00000012] bg-white no-underline transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-[#0064c1]/30 hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-6px_rgba(58,138,244,0.22),0_6px_32px_-2px_rgba(120,185,255,0.32)]"
    >
      <span
        class="grid place-items-center w-9 h-9 rounded-xl text-white text-xs font-bold shrink-0 overflow-hidden"
        style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 -6px 10px -6px rgba(26,106,202,0.5), 0 4px 10px -2px rgba(58,138,244,0.4); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
      >
        UI
      </span>
      <div class="flex-1 min-w-0 flex flex-col">
        <span class="text-xs font-semibold text-[#0a0a0a] truncate group-hover:text-[#0064c1] transition-colors">
          Usuario institucional
        </span>
        <span class="text-[0.7rem] text-[#787774] truncate">
          usuario@observatorio.edu
        </span>
      </div>
    </a>
  </div>
</aside>

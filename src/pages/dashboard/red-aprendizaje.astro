---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../components/Sidebar.astro";
import { ContenidoRedAprendizaje } from "../../modules/red-aprendizaje";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Gestión y aprobación de solicitudes para la Red de Aprendizaje"
    />
    <title>Observatorio · Red de Aprendizaje</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral con Usuarios Nuevos activa -->
      <Sidebar active="Usuarios Nuevos" />

      <!-- Contenido del Módulo -->
      <main class="flex-1 flex flex-col min-w-0">
        <ContenidoRedAprendizaje />
      </main>
    </div>
  </body>
</html>

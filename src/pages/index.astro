---
import "../styles/global.css";
import SkyShader from "../components/SkyShader.astro";
import CustomSelect from "../components/CustomSelect.astro";
import Input from "../components/Input.astro";
import {
  LetterIcon,
  LockIcon,
  UserIcon,
  CardIcon,
  PhoneIcon,
  CalendarIcon,
  BookIcon,
  ArrowRightIcon,
  UsersGroupRoundedIcon,
} from "@solar-icons/react/outline";

const meses = [
  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre",
].map((m, i) => ({ value: String(i + 1), label: m }));

const semestres = Array.from({ length: 10 }, (_, i) => ({
  value: String(i + 1),
  label: `${i + 1}° semestre`,
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Acceso y registro al Observatorio de Responsabilidad Social y Sostenibilidad"
    />
    <title>Observatorio · Acceso</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..900&family=Geist+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <main class="w-full min-h-svh flex p-0 overflow-hidden">
      <section
        id="panel"
        class="w-full min-h-svh grid grid-cols-1 md:grid-cols-[1.15fr_0.85fr] overflow-hidden bg-white isolate transition-[grid-template-columns] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
        aria-labelledby="main-title"
      >
        <!-- Lado izquierdo: arte encapsulado en card (sin sombras) -->
        <div
          id="art-side"
          class="p-3 md:p-4 lg:p-5 h-full w-full bg-[#fbfbfa] transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
        >
          <div
            class="relative overflow-hidden min-h-[clamp(14rem,30vh,20rem)] md:min-h-full h-full bg-[#cfe6fb] rounded-[24px] md:rounded-[28px]"
          >
            <SkyShader intensity="full" />

            <div
              class="absolute inset-0 grid grid-cols-5 grid-rows-3 opacity-10 pointer-events-none"
            >
              {
                Array.from({ length: 15 }).map(() => (
                  <span class="border border-white/60" />
                ))
              }
            </div>

            <p
              class="absolute left-0 bottom-[clamp(-1.2rem,-1.2vw,-0.4rem)] m-0 select-none pointer-events-none whitespace-nowrap text-[#1f5db4] opacity-[0.08] text-[clamp(4.5rem,12vw,12rem)] leading-[0.8] tracking-[-0.06em]"
              aria-hidden="true"
            >
              Observatorio
            </p>

            <div
              class="absolute z-10 left-[clamp(1.25rem,3vw,2.5rem)] right-[clamp(1.25rem,3vw,2.5rem)] bottom-[clamp(1.5rem,4vh,2.5rem)] md:bottom-[clamp(2rem,6vh,4rem)] flex flex-col gap-2"
            >
              <p
                class="m-0 mb-2 text-[#0064c1] text-[clamp(0.78rem,1vw,0.95rem)] font-medium tracking-[0.14em] uppercase animate-rise"
                style="animation-delay: 0.1s"
              >
                Acceso
              </p>
              <h1
                id="main-title"
                class="m-0 text-[clamp(2.8rem,8vw,7rem)] font-normal leading-[0.95] tracking-[-0.055em] text-[#0a0a0a] mix-blend-multiply opacity-90 animate-rise"
                style="animation-delay: 0.2s"
              >
                Observatorio
              </h1>
              <p
                class="m-0 mt-1 max-w-[22ch] text-[#2f3437] text-[clamp(1rem,2.2vw,1.9rem)] font-[540] leading-[1.05] tracking-[-0.03em] animate-rise"
                style="animation-delay: 0.3s"
              >
                Responsabilidad Social &amp; Sostenibilidad
              </p>
            </div>
          </div>
        </div>

        <!-- Lado derecho: formularios -->
        <div
          class="relative flex flex-col items-center justify-center gap-8 md:gap-10 px-[clamp(1.75rem,5vw,4rem)] py-[clamp(2rem,5vw,4rem)] bg-[#fbfbfa] w-full min-h-full"
        >
          <div
            class="w-full max-w-[26rem] flex flex-col items-center justify-center gap-4 text-center animate-rise"
            style="animation-delay: 0.25s"
          >
            <!-- Logo oficial centrado -->
            <div class="flex items-center justify-center w-full">
              <img
                src="/Group 19.svg"
                alt="Logo Observatorio de Responsabilidad Social y Sostenibilidad"
                class="h-14 w-auto object-contain transition-transform duration-300 hover:scale-[1.02]"
              />
            </div>

            <!-- Introducción -->
            <p
              class="m-0 text-[#2f3437] text-[clamp(1.02rem,1.4vw,1.2rem)] leading-[1.6] tracking-[-0.015em]"
            >
              El <strong class="font-semibold text-[#0a0a0a]"
                >Observatorio de Responsabilidad Social y Sostenibilidad</strong
              > es una plataforma dedicada al <span
                class="font-semibold text-[#0064c1] bg-[#0064c1]/8 px-2 py-0.5 rounded-md"
                >conocimiento y aprendizaje</span
              > en iniciativas sociales y ambientales.
            </p>
          </div>

          <!-- Login -->
          <form
            id="form-login"
            class="flex flex-col gap-5 w-full max-w-[26rem] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
            action="#"
            method="post"
          >
            <div class="animate-rise" style="animation-delay: 0.35s">
              <Input
                name="email"
                label="Correo"
                type="email"
                placeholder="nombre@ejemplo.com"
                autocomplete="email"
                icon={LetterIcon}
                required
              />
            </div>

            <div class="animate-rise" style="animation-delay: 0.42s">
              <Input
                name="password"
                label="Contraseña"
                type="password"
                placeholder="••••••••"
                autocomplete="current-password"
                icon={LockIcon}
                required
              />
            </div>

            <div class="animate-rise" style="animation-delay: 0.5s">
              <button
                type="submit"
                class="group relative w-full inline-flex items-center justify-center gap-2 mt-1 px-8 py-4 rounded-full text-white text-base font-semibold tracking-[-0.01em] whitespace-nowrap cursor-pointer overflow-hidden transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-0.5 hover:brightness-[1.04] hover:saturate-[1.05] hover:shadow-[inset_0_1.5px_1px_rgba(255,255,255,0.55),inset_0_9px_16px_-10px_rgba(255,255,255,0.35),inset_0_-14px_22px_-10px_rgba(26,106,202,0.5),0_12px_28px_-6px_rgba(58,138,244,0.55),0_12px_48px_-2px_rgba(120,185,255,0.7)] active:translate-y-0 active:scale-[0.985] focus-visible:outline-2 focus-visible:outline-[#0064c1] focus-visible:outline-offset-[3px]"
                style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 8px 22px -6px rgba(58,138,244,0.4), 0 6px 32px -2px rgba(120,185,255,0.58); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
              >
                <span
                  class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] bg-gradient-to-r from-transparent via-white/25 to-transparent pointer-events-none"
                ></span>
                <span class="relative z-10">Entrar</span>
                <ArrowRightIcon
                  size={18}
                  strokeWidth={2}
                  className="relative z-10 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1"
                />
              </button>
            </div>

            <div
              class="flex flex-col gap-3 mt-1 animate-rise"
              style="animation-delay: 0.58s"
            >
              <a
                href="#"
                class="relative w-fit text-[#0064c1] text-sm font-medium no-underline transition-colors hover:text-[#0f2fe8] after:absolute after:left-0 after:bottom-[-2px] after:w-full after:h-px after:bg-current after:scale-x-0 after:origin-left after:transition-transform after:duration-300 after:ease-[cubic-bezier(0.16,1,0.3,1)] hover:after:scale-x-100"
              >
                ¿Olvidaste tu contraseña?
              </a>
              <a
                href="#"
                id="link-register"
                class="group/link relative w-fit inline-flex items-center gap-1.5 text-[#0064c1] text-sm font-medium no-underline transition-colors hover:text-[#0f2fe8] after:absolute after:left-0 after:bottom-[-2px] after:w-full after:h-px after:bg-current after:scale-x-0 after:origin-left after:transition-transform after:duration-300 after:ease-[cubic-bezier(0.16,1,0.3,1)] hover:after:scale-x-100"
              >
                <UsersGroupRoundedIcon
                  size={16}
                  strokeWidth={1.5}
                  className="transition-transform duration-300 group-hover/link:scale-110"
                />
                Red de aprendizaje
              </a>
            </div>
          </form>

          <!-- Registro: Red de aprendizaje -->
          <form
            id="form-register"
            class="hidden flex-col gap-4 w-full max-w-[26rem] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
            action="#"
            method="post"
          >
            <Input
              name="nombre"
              label="Nombre completo"
              placeholder="Tu nombre completo"
              autocomplete="name"
              icon={UserIcon}
              required
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input
                name="cedula"
                label="Cédula"
                inputmode="numeric"
                placeholder="0000000000"
                icon={CardIcon}
                required
              />
              <Input
                name="telefono"
                label="Teléfono"
                type="tel"
                placeholder="300 123 4567"
                autocomplete="tel"
                icon={PhoneIcon}
                required
              />
            </div>

            <div class="flex flex-col gap-2">
              <span
                class="flex items-center gap-2 text-[#0a0a0a] text-sm font-[560] tracking-[-0.01em]"
              >
                <CalendarIcon
                  size={18}
                  strokeWidth={1.5}
                  className="text-[#0064c1]"
                />
                Fecha de nacimiento
              </span>
              <div class="grid grid-cols-[1fr_1.4fr_1fr] gap-3">
                <Input
                  name="dia"
                  label="Día"
                  type="number"
                  placeholder="Día"
                  min="1"
                  max="31"
                  required
                />
                <CustomSelect
                  name="mes"
                  label="Mes"
                  placeholder="Mes"
                  options={meses}
                  required
                />
                <Input
                  name="anio"
                  label="Año"
                  type="number"
                  placeholder="Año"
                  min="1950"
                  max="2010"
                  required
                />
              </div>
            </div>

            <Input
              name="universidad"
              label="Universidad"
              placeholder="Nombre de tu universidad"
              icon={BookIcon}
              required
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <CustomSelect
                name="semestre"
                label="Semestre"
                placeholder="Selecciona"
                options={semestres}
                required
              />
              <Input
                name="carrera"
                label="Carrera"
                placeholder="Tu carrera"
                required
              />
            </div>

            <button
              type="submit"
              class="group relative w-full inline-flex items-center justify-center gap-2 mt-2 px-8 py-4 rounded-full text-white text-base font-semibold tracking-[-0.01em] whitespace-nowrap cursor-pointer overflow-hidden transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-0.5 hover:brightness-[1.04] hover:saturate-[1.05] hover:shadow-[inset_0_1.5px_1px_rgba(255,255,255,0.55),inset_0_9px_16px_-10px_rgba(255,255,255,0.35),inset_0_-14px_22px_-10px_rgba(26,106,202,0.5),0_12px_28px_-6px_rgba(58,138,244,0.55),0_12px_48px_-2px_rgba(120,185,255,0.7)] active:translate-y-0 active:scale-[0.985] focus-visible:outline-2 focus-visible:outline-[#0064c1] focus-visible:outline-offset-[3px]"
              style="background-image: radial-gradient(120% 80% at 50% 0%, #ffffff42, #ffffff0a 36%, #ffffff00 54%), linear-gradient(#66b2ff, #4fa3ff 56%, #4a9ffb); box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.5), inset 0 9px 16px -10px rgba(255,255,255,0.3), inset 0 -14px 22px -10px rgba(26,106,202,0.5), 0 8px 22px -6px rgba(58,138,244,0.4), 0 6px 32px -2px rgba(120,185,255,0.58); text-shadow: 0 1px 2px rgba(18,86,175,0.32)"
            >
              <span
                class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] bg-gradient-to-r from-transparent via-white/25 to-transparent pointer-events-none"
              ></span>
              <span class="relative z-10">Unirme a la red</span>
              <ArrowRightIcon
                size={18}
                strokeWidth={2}
                className="relative z-10 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1"
              />
            </button>

            <a
              href="#"
              id="link-back"
              class="relative w-fit text-[#0064c1] text-sm font-medium no-underline transition-colors hover:text-[#0f2fe8] after:absolute after:left-0 after:bottom-[-2px] after:w-full after:h-px after:bg-current after:scale-x-0 after:origin-left after:transition-transform after:duration-300 after:ease-[cubic-bezier(0.16,1,0.3,1)] hover:after:scale-x-100"
            >
              Volver al acceso
            </a>
          </form>
        </div>
      </section>
    </main>

    <script>
      const linkRegister = document.getElementById("link-register");
      const linkBack = document.getElementById("link-back");
      const formLogin = document.getElementById("form-login");
      const formRegister = document.getElementById("form-register");
      const artSide = document.getElementById("art-side");
      const panel = document.getElementById("panel");

      function swapForms(show: HTMLElement, hide: HTMLElement) {
        hide.classList.add("opacity-0", "translate-y-3", "pointer-events-none");
        setTimeout(() => {
          hide.classList.add("hidden");
          hide.classList.remove("flex");
          show.classList.remove("hidden");
          show.classList.add("flex");
          requestAnimationFrame(() => {
            show.classList.remove(
              "opacity-0",
              "translate-y-3",
              "pointer-events-none",
            );
          });
        }, 200);
      }

      function showRegister() {
        swapForms(formRegister!, formLogin!);
        artSide?.classList.add("max-md:hidden", "md:!hidden");
        panel?.classList.remove("md:grid-cols-[1.15fr_0.85fr]");
        panel?.classList.add("md:grid-cols-1");
      }

      function showLogin() {
        swapForms(formLogin!, formRegister!);
        artSide?.classList.remove("max-md:hidden", "md:!hidden");
        panel?.classList.add("md:grid-cols-[1.15fr_0.85fr]");
        panel?.classList.remove("md:grid-cols-1");
      }

      linkRegister?.addEventListener("click", (e) => {
        e.preventDefault();
        showRegister();
      });

      linkBack?.addEventListener("click", (e) => {
        e.preventDefault();
        showLogin();
      });
    </script>
  </body>
</html>

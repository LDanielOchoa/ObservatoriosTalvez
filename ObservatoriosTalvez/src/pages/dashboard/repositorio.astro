---
export const prerender = false;

import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../components/Sidebar.astro";
import { ContenidoRepositorio } from "../../modules/repositorio";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Repositorio de documentos y producción científica del Observatorio de Responsabilidad Social"
    />
    <title>Observatorio · Repositorio</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral de navegación con Repositorio activo -->
      <Sidebar active="Repositorio" />

      <!-- Contenido principal del Repositorio -->
      <main class="flex-1 flex flex-col min-w-0">
        <ContenidoRepositorio />
      </main>
    </div>
  </body>
</html>

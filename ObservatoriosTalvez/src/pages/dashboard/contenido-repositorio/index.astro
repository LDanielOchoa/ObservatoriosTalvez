---
export const prerender = false;

import "../../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../../components/Sidebar.astro";
import { ContenidoAdminRepositorio } from "../../../modules/repositorio";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Administración y gestión de publicaciones y documentos del Repositorio institucional"
    />
    <title>Observatorio · Contenido Repositorios</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral con Contenido Repositorios activo -->
      <Sidebar active="Contenido Repositorios" />

      <!-- Contenido del Módulo -->
      <main class="flex-1 flex flex-col min-w-0">
        <ContenidoAdminRepositorio />
      </main>
    </div>
  </body>
</html>

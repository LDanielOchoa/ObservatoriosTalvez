---
import "../../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../../components/Sidebar.astro";
import { ContenidoUsuarios } from "../../../modules/usuarios";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Gestión de usuarios y registros de la Red de Aprendizaje"
    />
    <title>Observatorio · Usuarios Estudiantes</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral de navegación con Usuarios Estudiantes activo -->
      <Sidebar active="Usuarios Estudiantes" />

      <!-- Contenido de Gestión de Usuarios -->
      <main class="flex-1 flex flex-col min-w-0">
        <ContenidoUsuarios />
      </main>
    </div>
  </body>
</html>

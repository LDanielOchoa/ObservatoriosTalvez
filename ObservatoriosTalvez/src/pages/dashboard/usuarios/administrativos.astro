---
import "../../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../../components/Sidebar.astro";
import { ContenidoUsuariosAdmin } from "../../../modules/usuarios";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Gestión de usuarios administrativos y accesos del Observatorio"
    />
    <title>Observatorio · Usuarios Administrativos</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral con Usuarios Administrativos activo -->
      <Sidebar active="Usuarios Administrativos" />

      <!-- Contenido de Gestión de Usuarios Administrativos -->
      <main class="flex-1 flex flex-col min-w-0">
        <ContenidoUsuariosAdmin />
      </main>
    </div>
  </body>
</html>

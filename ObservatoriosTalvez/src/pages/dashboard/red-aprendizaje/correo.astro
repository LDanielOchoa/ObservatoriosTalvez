---
import "../../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../../components/Sidebar.astro";
import { ContenidoCorreosRed } from "../../../modules/red-aprendizaje";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Gestión de correos, plantillas y comunicaciones de la Red de Aprendizaje"
    />
    <title>Observatorio · Correos de la Red de Aprendizaje</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral con sub-opción Correo activa -->
      <Sidebar active="Correo" />

      <!-- Contenido del Módulo de Correos -->
      <main class="flex-1 flex flex-col min-w-0">
        <ContenidoCorreosRed />
      </main>
    </div>
  </body>
</html>

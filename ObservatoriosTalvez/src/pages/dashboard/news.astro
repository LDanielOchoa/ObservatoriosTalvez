---
export const prerender = false;

import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Sidebar from "../../components/Sidebar.astro";
import { ContenidoNewsFeed } from "../../modules/dashboard";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="News Feed y actualidad del Observatorio de Responsabilidad Social y Sostenibilidad"
    />
    <title>Observatorio · News Feed</title>
    <ClientRouter />
  </head>
  <body class="bg-[#fbfbfa] text-[#0a0a0a]">
    <div class="flex min-h-svh w-full">
      <!-- Barra lateral de navegación con News Feed activo -->
      <Sidebar active="News Feed" />

      <!-- Contenido principal de News Feed -->
      <main class="flex-1 flex flex-col min-w-0">
        <ContenidoNewsFeed />
      </main>
    </div>
  </body>
</html>
